{
  "model": "claude-chatgpt-web-gpt-6-pro",
  "availableModels": [
    "claude-chatgpt-web-gpt-6-pro"
  ],
  "enforceAvailableModels": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:17841/v1/messages/steering",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $CODEX_CHATGPT_WEB_CONTROL_TOKEN"
            },
            "allowedEnvVars": [
              "CODEX_CHATGPT_WEB_CONTROL_TOKEN"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:17841/v1/messages/steering",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $CODEX_CHATGPT_WEB_CONTROL_TOKEN"
            },
            "allowedEnvVars": [
              "CODEX_CHATGPT_WEB_CONTROL_TOKEN"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:17841/v1/messages/steering",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $CODEX_CHATGPT_WEB_CONTROL_TOKEN"
            },
            "allowedEnvVars": [
              "CODEX_CHATGPT_WEB_CONTROL_TOKEN"
            ]
          }
        ]
      }
    ]
  }
}
